# 원본 CSV는 1GB 이상(GitHub 100MB 제한 초과) → 저장소에 올리지 않음. 각자 data/raw에 직접 다운로드
data/raw/*
!data/raw/.gitkeep

.env
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.vscode/

# 재생성 가능한 대용량 처리 결과(>5MB) — 재현 방법은 README 12절
data/processed/gangnam_station_timeseries.csv
data/processed/gangnam_station_observation_mask.csv
data/processed/gangnam_forecast_samples_h*.csv

# 결과물은 figures만 추적
outputs/*
!outputs/figures/
